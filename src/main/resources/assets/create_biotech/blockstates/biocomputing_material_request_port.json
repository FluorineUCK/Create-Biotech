{
  "multipart": [
    { "when": { "base_material": "opaque" }, "apply": { "model": "create_biotech:block/biocomputing/computer/casing" } },
    { "when": { "base_material": "transparent" }, "apply": { "model": "create_biotech:block/biocomputing/computer/transparent_casing" } },
    { "when": { "facing": "north" }, "apply": { "model": "create_biotech:block/biocomputing/terminal/panel", "y": 0 } },
    { "when": { "facing": "east" }, "apply": { "model": "create_biotech:block/biocomputing/terminal/panel", "y": 90 } },
    { "when": { "facing": "south" }, "apply": { "model": "create_biotech:block/biocomputing/terminal/panel", "y": 180 } },
    { "when": { "facing": "west" }, "apply": { "model": "create_biotech:block/biocomputing/terminal/panel", "y": 270 } }
  ]
}
